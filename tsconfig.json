{
	"compilerOptions": {
		"strict": true,
		"checkJs": true,
		"allowJs": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src"],
	"exclude": ["src/test/wischen.js"]
}
